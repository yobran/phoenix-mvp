generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum RaffleStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum PaymentMethod {
  MANUAL
  STK_PUSH
}

enum TicketStatus {
  RESERVED
  SOLD
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  phone        String   @unique
  email        String?  @unique
  referralCode String?  @unique
  role         UserRole @default(USER)

  password   String
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets  Ticket[]
  payments Payment[]
  winner   Winner[]
}

model Raffle {
  id String @id @default(cuid())

  title       String
  description String
  prize       String
  imageUrl String?

  ticketPrice  Float
  totalTickets Int
  soldTickets  Int   @default(0)

  drawDate DateTime
  status   RaffleStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets  Ticket[]
  payments Payment[]
  winner   Winner?
}

model Ticket {
  id           String @id @default(cuid())
  ticketNumber String @unique

  status TicketStatus @default(RESERVED)

  userId   String
  raffleId String

  user   User   @relation(fields: [userId], references: [id])
  raffle Raffle @relation(fields: [raffleId], references: [id])

  payment Payment?
  winner  Winner?
}

model Winner {
  id String @id @default(cuid())

  raffleId String @unique
  ticketId String @unique
  userId   String

  raffle Raffle @relation(fields: [raffleId], references: [id])
  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Payment {
  id String @id @default(cuid())

  amount Float

  mpesaReference  String? @unique
  transactionCode String? @unique
  paymentMessage  String?

  status        PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(MANUAL)

  expiresAt DateTime?

  userId   String
  ticketId String @unique
  raffleId String

  phone String?

  checkoutRequestId String?
  merchantRequestId String?

  verifiedAt DateTime?
  verifiedBy String?

  user   User   @relation(fields: [userId], references: [id])
  ticket Ticket @relation(fields: [ticketId], references: [id])
  raffle Raffle @relation(fields: [raffleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
